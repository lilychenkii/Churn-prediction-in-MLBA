<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/asset/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet"/>
    <title>Sipsweet</title>
</head>
<body>
    <header id="header">
        <div class="container">
            <div class="row-flex">
                <div class="header-bar-icon">
                    <i class="ri-menu-line"></i>
                </div>
                <div class="header-logo">
                    <img src="~/images/Logo.png" alt="SipSweet Logo"/>
                </div>

                <div class="header-nav">
                    <nav>
                        <ul>
                            <li><a href="index.html">HOME</a></li>
                            <li class="menu-dropdown">
                                <a href="menu.html">MENU <i class="ri-arrow-down-s-line"></i></a>
                                <ul class="dropdown-content">
                                    <li class="dropdown-category">
                                        <a href="menu.html?category=drink">DRINK <i class="ri-arrow-right-s-line"></i></a>
                                        <ul class="dropdown-subcategory">
                                            <li><a href="menu.html?category=coffee">Coffee</a></li>
                                            <li><a href="menu.html?category=tea-milktea">Tea & Milktea</a></li>
                                            <li><a href="menu.html?category=frappuccino">Frappuccino</a></li>
                                            <li><a href="menu.html?category=latte">Latte</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown-category">
                                        <a href="menu.html?category=cake">CAKE <i class="ri-arrow-right-s-line"></i></a>
                                        <ul class="dropdown-subcategory">
                                            <li><a href="menu.html?category=cold-cake">Cold Cake</a></li>
                                            <li><a href="menu.html?category=bread">Bread</a></li>
                                            <li><a href="menu.html?category=cookies">Cookies</a></li>
                                            <li><a href="menu.html?category=tart">Tart</a></li>
                                            <li><a href="menu.html?category=sponge-cake">Sponge Cake</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                            <li><a href="">ABOUT US</a></li>
                            <li><a href="">CONTACT US</a></li>
                            <li><a href="login.html">LOGIN</a></li>
                            <li><a href="signup.html">SIGN UP</a></li>
                        </ul>
                    </nav>
                </div>
                <div class="header-search">
                    <input type="text" placeholder="Search">
                    <i class="ri-search-line"></i>
                </div>
                <div class="header-cart">
                    <i class="ri-shopping-cart-line" number="0"></i>
                </div>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <div class="cart-overlay">
        <div class="cart-modal">
            <div class="cart-header">
                <h2>Cart</h2>
                <i class="ri-close-line cart-close"></i>
            </div>
            <div class="cart-content">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product ID</th>
                            <th>Images</th>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total price:</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody id="cart-items">
                        </tbody>
                </table>
                <div class="cart-empty" style="display: none;">
                    <p>Empty cart</p>
                </div>
            </div>
            <div class="cart-footer">
                <div class="cart-total">
                    <h3>Total: <span id="cart-total-price">0 đ</span></h3>
                </div>
                <div class="cart-actions">
                    <button class="main-btn" onclick="continueShopping()">Continue shopping</button>
                    <button class="main-btn checkout-btn" onclick="checkout()">Check out</button>
                </div>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container">
            <div class="row-grid">
                <div class="footer-item">
                    <p>SIPCLUB</p>
                    <p>Sign up for membership</p>
                    <p>Benefits and privileges</p>
                </div>
                <div class="footer-item">
                    <p>POLICY</p>
                    <p>Order cancellation policy</p>
                    <p>Promotion policy</p>
                    <p>Privacy policy</p>
                    <p>Shipping policy</p>
                </div>
                <div class="footer-item">
                    <p>CUSTOMER SERVICE</p>
                    <p>FAQs</p>
                </div>
                <div class="footer-item">
                    <p>ADDRESS</p>
                    <p>Đỗ Mười, Linh Xuân, Thủ Đức, Thành phố Hồ Chí Minh</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/asset/js/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>